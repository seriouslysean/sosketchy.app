---
import { APP_NAME, BUSINESS_NAME } from '../utils/env';
import { getFullUrl } from '../utils/url-utils';

interface Props {
  collectionPage?: { name: string; description: string; url: string };
}

const { collectionPage } = Astro.props;

const siteRoot = getFullUrl('/');

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteRoot}#org`,
      name: BUSINESS_NAME,
      url: siteRoot,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}#site`,
      url: siteRoot,
      name: APP_NAME,
      inLanguage: 'en',
      publisher: { '@id': `${siteRoot}#org` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteRoot}#app`,
      name: APP_NAME,
      applicationCategory: 'GameApplication',
      operatingSystem: 'iOS 18',
      url: siteRoot,
      image: getFullUrl('/og-image.png'),
      creator: { '@id': `${siteRoot}#org` },
    },
    ...(collectionPage
      ? [
          {
            '@type': 'CollectionPage',
            '@id': `${collectionPage.url}#page`,
            url: collectionPage.url,
            name: collectionPage.name,
            description: collectionPage.description,
            inLanguage: 'en',
            isPartOf: { '@id': `${siteRoot}#site` },
            about: { '@id': `${siteRoot}#app` },
          },
        ]
      : []),
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)}></script>
