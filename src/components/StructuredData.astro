---
import { PUBLIC_APP_NAME, PUBLIC_BUSINESS_NAME } from 'astro:env/client';

const site = Astro.site!.href.replace(/\/$/, '');

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#org`,
      name: PUBLIC_BUSINESS_NAME,
      url: site,
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#site`,
      url: site,
      name: PUBLIC_APP_NAME,
      inLanguage: 'en',
      publisher: { '@id': `${site}/#org` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#app`,
      name: PUBLIC_APP_NAME,
      applicationCategory: 'GameApplication',
      operatingSystem: 'iOS 17',
      url: site,
      image: `${site}/og-image.png`,
      creator: { '@id': `${site}/#org` },
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)}></script>
