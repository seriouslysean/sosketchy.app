---
import { PUBLIC_APP_NAME, PUBLIC_BUSINESS_NAME } from 'astro:env/client';
import { getFullUrl } from '../utils/url-utils';

const siteRoot = getFullUrl('/').replace(/\/$/, '');

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteRoot}/#org`,
      name: PUBLIC_BUSINESS_NAME,
      url: siteRoot,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteRoot}/#site`,
      url: siteRoot,
      name: PUBLIC_APP_NAME,
      inLanguage: 'en',
      publisher: { '@id': `${siteRoot}/#org` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${siteRoot}/#app`,
      name: PUBLIC_APP_NAME,
      applicationCategory: 'GameApplication',
      operatingSystem: 'iOS 17',
      url: siteRoot,
      image: getFullUrl('/og-image.png'),
      creator: { '@id': `${siteRoot}/#org` },
    },
  ],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)}></script>
