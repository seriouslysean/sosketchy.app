---
import { Image } from 'astro:assets';
import { APP_NAME } from '../utils/env';
import splashArt from '../assets/splash-art.png';

interface Props {
  subtitle: string;
}

const { subtitle } = Astro.props;
---

<article class="splash splash--fit">
  <Image
    class="splash__art"
    src={splashArt}
    alt=""
    width={1024}
    height={819}
    densities={[1, 2]}
    sizes="(max-width: 48rem) calc(100vw - 2rem), 44rem"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <h1 class="splash__title">{APP_NAME}</h1>
  <p class="splash__sub">{subtitle}</p>
</article>
