---
import { Image } from 'astro:assets';
import SiteLink from './SiteLink.astro';
import AppStoreBadge from '../assets/app-store-badge.svg';
import { copy } from '../i18n/copy';
import { APP_NAME, APP_STORE_URL } from '../utils/env';
import splashArt from '../assets/splash-art.png';

interface Props {
  subtitle: string;
}

const { subtitle } = Astro.props;
const badgeAlt = copy.common.downloadAppStore;
---

<article class="splash splash--fit">
  <Image
    class="splash__art"
    src={splashArt}
    alt=""
    width={1024}
    height={819}
    densities={[1, 2]}
    sizes="(max-width: 48rem) calc(100vw - 2rem), 44rem"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />
  <h1 class="splash__title">{APP_NAME}</h1>
  <p class="splash__sub">{subtitle}</p>
  {APP_STORE_URL ? (
    <SiteLink class="splash__badge" href={APP_STORE_URL} aria-label={badgeAlt}>
      <AppStoreBadge aria-hidden="true" focusable="false" />
    </SiteLink>
  ) : (
    <span class="splash__badge splash__badge--disabled" role="img" aria-label={badgeAlt} aria-disabled="true">
      <AppStoreBadge aria-hidden="true" focusable="false" />
    </span>
  )}
</article>
