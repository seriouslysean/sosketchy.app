---
import { getUrl } from '../utils/url-utils';

interface Props {
  href: string;
  [key: string]: unknown;
}

const { href, class: className, rel, ...attrs } = Astro.props;

const isExternal = href.startsWith('http://') || href.startsWith('https://');
const isPassthrough = isExternal || href.startsWith('#') || href.startsWith('mailto:');

const finalHref = isPassthrough ? href : getUrl(href);
const finalRel = attrs.target === '_blank' && !rel ? 'noopener noreferrer' : rel;
---

<a href={finalHref} rel={finalRel} class={className} {...attrs}>
  <slot />
</a>
