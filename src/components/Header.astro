---
import { Image } from 'astro:assets';
import SiteLink from './SiteLink.astro';
import { APP_NAME } from 'astro:env/client';
import icon from '../assets/icon.png';
---

<header class="site-header">
  <SiteLink href="/" class="site-header__link" aria-label={`${APP_NAME} home`}>
    <Image
      class="site-header__icon"
      src={icon}
      alt=""
      width={32}
      height={32}
      densities={[1, 2]}
      loading="eager"
    />
    {APP_NAME}
  </SiteLink>
</header>
