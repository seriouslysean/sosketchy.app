---
import { PUBLIC_BUSINESS_NAME, PUBLIC_BUSINESS_URL } from 'astro:env/client';

const year = new Date().getFullYear();
---

<footer>
  <small>
    <a href="/">Home</a> · <a href="/privacy">Privacy</a> · <a href="/support">Support</a> · &copy; {year} <a
      href={PUBLIC_BUSINESS_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${PUBLIC_BUSINESS_NAME}, opens in new tab`}
    >{PUBLIC_BUSINESS_NAME}</a>
  </small>
</footer>
