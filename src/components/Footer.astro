---
import SiteLink from './SiteLink.astro';
import { BUSINESS_NAME, BUSINESS_URL } from 'astro:env/client';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <small>
    <SiteLink href="/privacy">Privacy</SiteLink> · <SiteLink href="/support">Support</SiteLink>
  </small>
  <small>
    &copy; {year} <SiteLink
      href={BUSINESS_URL}
      target="_blank"
      aria-label={`${BUSINESS_NAME}, opens in new tab`}
    >{BUSINESS_NAME}</SiteLink>
  </small>
</footer>
