---
import SiteLink from './SiteLink.astro';
import { BUSINESS_NAME, BUSINESS_URL } from '../utils/env';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <small>
    <SiteLink href="/">Home</SiteLink> · <SiteLink href="/privacy">Privacy</SiteLink> · <SiteLink href="/support">Support</SiteLink>
  </small>
  <small>
    &copy; {year}{' '}
    {BUSINESS_URL ? (
      <SiteLink
        href={BUSINESS_URL}
        target="_blank"
        aria-label={`${BUSINESS_NAME}, opens in new tab`}
      >{BUSINESS_NAME}</SiteLink>
    ) : (
      BUSINESS_NAME
    )}
  </small>
</footer>
