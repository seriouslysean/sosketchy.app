---
import Doc from '../layouts/Doc.astro';
import { APP_NAME } from '../utils/env';
import { formatReleaseDate, releaseNotes } from '../utils/release-notes';
---

<Doc
  title="Releases"
  description={`What changed in each ${APP_NAME} update.`}
>
  <header class="doc__header">
    <h1>Releases</h1>
    <p>What changed in each {APP_NAME} update, newest first.</p>
  </header>

  {releaseNotes.map((note) => (
    <section>
      <h2>{note.version}</h2>
      <p class="doc__date"><time datetime={note.date}>{formatReleaseDate(note.date)}</time></p>
      <ul>
        {note.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>
    </section>
  ))}
</Doc>
