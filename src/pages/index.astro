---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import splashArt from '../assets/splash-art.png';
---

<Base>
  <Header />
  <main id="main">
    <article class="splash">
      <Image
        class="splash__art"
        src={splashArt}
        alt=""
        width={1024}
        height={819}
        densities={[1, 2]}
        sizes="(max-width: 48rem) calc(100vw - 2rem), 44rem"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <h1 class="splash__title">So Sketchy</h1>
      <p class="splash__sub">A drawing game inside iMessage.</p>
    </article>
  </main>
  <Footer />
</Base>
