---
import Doc from '../layouts/Doc.astro';
import SiteLink from '../components/SiteLink.astro';
import { APP_NAME, SUPPORT_EMAIL } from '../utils/env';
---

<Doc
  title="Support"
  description={`Support for ${APP_NAME}, including contact information and basic help.`}
>
  <header class="doc__header">
    <h1>Support</h1>
    <p>
      Need help with {APP_NAME}? Email <SiteLink href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</SiteLink>.
    </p>
  </header>

  <section>
    <h2>Common actions</h2>

    <h3>Open the game</h3>
    <p>
      In a Messages conversation, tap the Apps button next to the text
      field and open {APP_NAME} from the iMessage app drawer.
    </p>

    <h3>Report a word</h3>
    <p>
      Tap Report on the word. The app opens a pre-filled email you can
      send to us.
    </p>

    <h3>Save to Photos</h3>
    <p>
      {APP_NAME} asks for Photos access only when you save a drawing.
      You can change Photos access later in the app's Settings screen
      or in iOS Settings.
    </p>

    <h3>Privacy</h3>
    <p>
      Details on data handling are in the <SiteLink href="/privacy">privacy policy</SiteLink>.
    </p>
  </section>
</Doc>
