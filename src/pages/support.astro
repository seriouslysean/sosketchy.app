---
import Doc from '../layouts/Doc.astro';
import SiteLink from '../components/SiteLink.astro';
import { APP_NAME, SUPPORT_EMAIL } from '../utils/env';
---

<Doc
  title="Support"
  description={`Support for ${APP_NAME}, including contact information and basic help.`}
>
  <header class="doc__header">
    <h1>Support</h1>
    <p>
      Need help with {APP_NAME}? Email <SiteLink href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</SiteLink>.
    </p>
  </header>

  <section>
    <h2>How to</h2>

    <h3>Open the game</h3>
    <p>
      In a Messages conversation, tap the Apps button next to the text
      field and open {APP_NAME} from the iMessage app drawer.
    </p>

    <h3>Report a word</h3>
    <p>
      While you're guessing or on the results screen, tap Help and then
      Report a problem. The app asks whether to attach the drawing, then
      opens a pre-filled email you can send to us.
    </p>

    <h3>Save to Photos</h3>
    <p>
      Tap Save Image to keep the drawing, or Save Replay to keep a video of
      it being drawn. The app asks for Photos access the first time, and
      you can change that later in iOS Settings.
    </p>
  </section>
</Doc>
