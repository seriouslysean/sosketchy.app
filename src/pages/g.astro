---
import Splash from '../layouts/Splash.astro';
import SplashContent from '../components/SplashContent.astro';
import Footer from '../components/Footer.astro';
import { copy, formatCopy } from '../i18n/copy';
import { APP_NAME } from '../utils/env';

const pageCopy = copy.pages.g;
const title = pageCopy.title;
const description = APP_NAME
  ? formatCopy(pageCopy.description, { appName: APP_NAME })
  : pageCopy.descriptionFallback;
---

<Splash title={title} description={description} noindex referrer="no-referrer">
  <script is:inline>
    if (window.location.search) {
      window.history.replaceState?.(
        window.history.state,
        '',
        window.location.pathname + window.location.hash,
      );
    }
  </script>
  <SplashContent subtitle={title} />
  <Footer slot="footer" />
</Splash>
