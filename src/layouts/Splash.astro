---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  referrer?: string;
}

const { title, description, noindex, referrer } = Astro.props;
---

<Base title={title} description={description} noindex={noindex} referrer={referrer}>
  <main id="main">
    <slot />
  </main>
  <Footer />
</Base>
