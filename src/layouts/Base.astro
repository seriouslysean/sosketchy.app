---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import StructuredData from '../components/StructuredData.astro';
import { copy, formatCopy } from '../i18n/copy';
import { APP_NAME } from '../utils/env';
import { getFullUrl, getUrl } from '../utils/url-utils';
import splashArt from '../assets/splash-art.png';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  referrer?: string;
  ogImage?: string;
  ogImageType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageAlt?: string;
}

const defaultDescription = APP_NAME
  ? formatCopy(copy.site.defaultDescription, { appName: APP_NAME })
  : copy.site.defaultDescriptionFallback;
const defaultOgImage = await getImage({
  src: splashArt,
  width: 1200,
  format: 'png',
});
const defaultOgImageAlt = APP_NAME
  ? formatCopy(copy.site.defaultOgImageAlt, { appName: APP_NAME })
  : copy.site.defaultOgImageAltFallback;

const {
  title: section,
  description = defaultDescription,
  noindex = false,
  referrer = 'strict-origin-when-cross-origin',
  ogImage: ogImagePath = defaultOgImage.src,
  ogImageType = 'image/png',
  ogImageWidth = defaultOgImage.attributes.width,
  ogImageHeight = defaultOgImage.attributes.height,
  ogImageAlt = defaultOgImageAlt,
} = Astro.props;

const title = [section, APP_NAME].filter(Boolean).join(' | ');

const canonical = getFullUrl(Astro.url.pathname);
const ogImage = getFullUrl(ogImagePath);
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="referrer" content={referrer} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#C75B6A" />
    <meta name="color-scheme" content="light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={APP_NAME} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="icon" type="image/png" sizes="32x32" href={getUrl('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={getUrl('/favicon-16.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={getUrl('/apple-touch-icon.png')} />
    <link rel="manifest" href={getUrl('/manifest.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content={ogImageWidth} />
    <meta property="og:image:height" content={ogImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <StructuredData />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
